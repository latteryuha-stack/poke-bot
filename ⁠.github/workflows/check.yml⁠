name: Check Stock Bot

on:
  push:                   # ★保存した瞬間に自動で1回動く！
  schedule:
    - cron: '*/10 * * * *'  # その後は10分おきに自動実行
  workflow_dispatch:

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - name: Code Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.x'

      - name: Install Tools
        run: pip install cloudscraper

      - name: Run Bot
        run: python main.py
